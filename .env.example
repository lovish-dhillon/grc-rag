# grc-rag — environment template. Copy to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# Anthropic API key — used ONLY by the offline eval harness / CI judge (the claim-by-claim
# faithfulness LLM-judge, ADR-0008). The retrieval→generation request path and the API/UI do
# NOT need it; the local Ollama generator is keyless. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-your-key-here
